{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@speakerwiz/core": ["packages/core/src/index.ts"],
      "@speakerwiz/core/*": ["packages/core/src/*"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "demo/**/*.ts", "demo/**/*.tsx"]
}
