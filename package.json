{
  "name": "speakerwiz",
  "version": "0.1.0",
  "description": "Physics-simulated audio visualization for the web",
  "private": true,
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "scripts": {
    "build":      "bun run --filter \"*\" build",
    "dev":        "bun run --filter speakerwiz-demo dev",
    "test":       "bun run --filter \"*\" test",
    "lint":       "bun run --filter \"*\" lint",
    "typecheck":  "bun run --filter \"*\" typecheck",
    "changeset":  "changeset",
    "release":    "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli":          "^2.27.0",
    "typescript":               "^5.4.0",
    "vite":                     "^5.2.0",
    "vitest":                   "^1.6.0"
  }
}
